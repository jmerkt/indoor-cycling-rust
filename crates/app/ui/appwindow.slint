import { Palette, ScrollView, Slider, VerticalBox, HorizontalBox } from "std-widgets.slint";

global Theme {
    out property <brush> app-background: #080c12;
    out property <brush> header-background: #0d131d;
    out property <brush> surface: #111925;
    out property <brush> surface-raised: #172231;
    out property <brush> surface-hover: #202e40;
    out property <brush> border: #273548;
    out property <brush> border-strong: #3a4b63;
    out property <brush> text: #f4f7fb;
    out property <brush> text-secondary: #a7b4c5;
    out property <brush> text-muted: #738398;
    out property <brush> accent: #2dd4bf;
    out property <brush> accent-strong: #14b8a6;
    out property <brush> accent-soft: #123a3a;
    out property <brush> success: #34d399;
    out property <brush> warning: #fbbf24;
    out property <brush> danger: #fb7185;
    out property <brush> blue: #60a5fa;
    out property <brush> violet: #a78bfa;
}

export struct DeviceListItem {
    id: string,
    name: string,
    capabilities: string,
    signal: string,
    supports-power: bool,
    supports-heart-rate: bool,
    supports-cadence: bool,
    supports-smart-trainer: bool,
}

export struct WorkoutStageItem {
    name: string,
    duration-text: string,
    timeline-width-px: int,
    target-percent: int,
    target-watts: int,
    progress-percent: int,
    active: bool,
    completed: bool,
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    // 0 = secondary, 1 = primary, 2 = destructive
    in property <int> variant: 0;
    callback clicked();

    min-width: 120px;
    min-height: 44px;
    max-height: 44px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.4;
    background: root.variant == 1
        ? touch.pressed && root.enabled ? #0f9488 : touch.has-hover && root.enabled ? #22c7b5 : Theme.accent-strong
        : root.variant == 2
            ? touch.pressed && root.enabled ? #4a202b : touch.has-hover && root.enabled ? #39202a : transparent
            : touch.pressed && root.enabled ? #273548 : touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface-raised;
    border-color: root.variant == 1 ? Theme.accent-strong : root.variant == 2 ? #7f3547 : Theme.border-strong;
    border-width: 1px;
    border-radius: 8px;

    Text {
        text: root.text;
        color: root.variant == 1 ? #041412 : root.variant == 2 ? Theme.danger : Theme.text;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    min-width: 112px;
    min-height: 42px;
    max-height: 42px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-raised : transparent;
    border-color: root.selected ? #24695f : transparent;
    border-width: 1px;
    border-radius: 9px;

    Text {
        text: root.text;
        color: root.selected ? Theme.accent : Theme.text-secondary;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component WorkoutTypeButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    min-width: 120px;
    min-height: 42px;
    max-height: 42px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : Theme.surface-raised;
    border-color: root.selected ? Theme.accent-strong : Theme.border;
    border-width: 1px;
    border-radius: 8px;

    Text {
        text: root.text;
        color: root.selected ? Theme.accent : Theme.text-secondary;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component FtpStepButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    opacity: root.enabled ? 1 : 0.45;
    background: touch.pressed && root.enabled ? #2b3c50 : touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface-raised;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: 8px;

    Text {
        text: root.text;
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component FtpControl inherits Rectangle {
    in property <int> value;
    in property <int> step-value: 5;
    callback changed(int);

    changed value => {
        ftp-input.text = root.value + "";
    }

    function apply-value(value: int) {
        let bounded-value = max(50, min(600, value));
        ftp-input.text = bounded-value + "";
        root.changed(bounded-value);
    }

    min-width: 210px;
    max-width: 210px;
    min-height: 116px;
    max-height: 116px;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 12px;

    VerticalBox {
        padding: 14px;
        spacing: 4px;

        Text {
            text: "FTP";
            color: Theme.text-secondary;
            font-size: 13px;
            font-weight: 700;
        }

        HorizontalBox {
            spacing: 6px;

            FtpStepButton {
                text: "-";
                enabled: root.value > 50;
                clicked => { root.apply-value(root.value - root.step-value); }
            }

            ftp-input := TextInput {
                text: root.value + "";
                font-size: 26px;
                font-weight: 800;
                color: Theme.text;
                horizontal-alignment: right;
                vertical-alignment: center;
                min-width: 70px;
                accepted => {
                    if self.text.is-float() {
                        root.apply-value(round(self.text.to-float()));
                    } else {
                        self.text = root.value + "";
                    }
                    self.clear-focus();
                }
            }

            Text {
                text: "W";
                color: Theme.text-secondary;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }

            FtpStepButton {
                text: "+";
                enabled: root.value < 600;
                clicked => { root.apply-value(root.value + root.step-value); }
            }
        }
    }
}

component InlineFtpStepButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    opacity: root.enabled ? 1 : 0.4;
    background: touch.pressed && root.enabled ? #2b3c50
        : touch.has-hover && root.enabled ? Theme.surface-hover : Theme.surface;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.text;
        color: Theme.text;
        font-size: 18px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component CompactFtpControl inherits Rectangle {
    in property <int> value;
    in property <int> step-value: 5;
    callback changed(int);

    changed value => {
        ftp-input.text = root.value + "";
    }

    function apply-value(value: int) {
        let bounded-value = max(50, min(600, value));
        ftp-input.text = bounded-value + "";
        root.changed(bounded-value);
    }

    min-width: 220px;
    max-width: 220px;
    min-height: 42px;
    max-height: 42px;
    background: Theme.surface-raised;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: 8px;

    HorizontalBox {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 5px;

        Text {
            text: "FTP";
            color: Theme.text-secondary;
            font-size: 11px;
            font-weight: 800;
            min-width: 30px;
            vertical-alignment: center;
        }

        InlineFtpStepButton {
            text: "−";
            enabled: root.value > 50;
            clicked => { root.apply-value(root.value - root.step-value); }
        }

        ftp-input := TextInput {
            text: root.value + "";
            color: Theme.text;
            font-size: 16px;
            font-weight: 800;
            min-width: 52px;
            horizontal-alignment: right;
            vertical-alignment: center;
            accepted => {
                if self.text.is-float() {
                    root.apply-value(round(self.text.to-float()));
                } else {
                    self.text = root.value + "";
                }
                self.clear-focus();
            }
        }

        Text {
            text: "W";
            color: Theme.text-muted;
            font-size: 11px;
            min-width: 14px;
            vertical-alignment: center;
        }

        InlineFtpStepButton {
            text: "+";
            enabled: root.value < 600;
            clicked => { root.apply-value(root.value + root.step-value); }
        }
    }
}

component BuilderSliderRow inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <int> minimum-value: 1;
    in property <int> maximum-value: 11;
    in property <int> step-value: 1;
    in property <string> suffix: " / 11";
    callback changed(int);

    min-height: 56px;
    background: Theme.surface-raised;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 9px;

    HorizontalBox {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 14px;
            font-weight: 700;
            min-width: 160px;
            vertical-alignment: center;
        }

        Slider {
            minimum: root.minimum-value;
            maximum: root.maximum-value;
            step: root.step-value;
            value: root.value;
            changed(value) => {
                root.changed(round(value));
            }
            min-width: 300px;
        }

        Text {
            text: root.value + root.suffix;
            color: Theme.accent;
            font-size: 20px;
            font-weight: 800;
            min-width: 100px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CompactErgControl inherits Rectangle {
    in property <bool> enabled;
    in property <bool> available;
    in property <bool> pending;
    in property <bool> error;
    in property <string> status;
    callback toggled();

    min-width: 240px;
    max-width: 240px;
    min-height: 42px;
    max-height: 42px;
    opacity: root.available && !root.pending ? 1 : 0.72;
    background: root.enabled ? Theme.accent-soft : Theme.surface-raised;
    border-color: root.error ? Theme.danger : root.enabled ? Theme.accent-strong : Theme.border-strong;
    border-width: 1px;
    border-radius: 8px;

    HorizontalBox {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;

        VerticalBox {
            spacing: 0px;

            Text {
                text: "ERG MODE";
                color: root.error ? Theme.danger : root.enabled ? Theme.accent : Theme.text;
                font-size: 11px;
                font-weight: 800;
                vertical-alignment: bottom;
            }

            Text {
                text: root.error ? root.status
                    : root.pending ? "Updating trainer…"
                    : root.status;
                color: root.error ? Theme.danger : Theme.text-muted;
                font-size: 9px;
                vertical-alignment: top;
                overflow: elide;
            }
        }

        Rectangle {
            min-width: 42px;
            max-width: 42px;
            min-height: 24px;
            max-height: 24px;
            background: root.enabled ? Theme.accent-strong : #263345;
            border-radius: 12px;

            Rectangle {
                x: root.enabled ? parent.width - self.width - 3px : 3px;
                y: 3px;
                width: 18px;
                height: 18px;
                background: root.enabled ? #eafffb : #8493a7;
                border-radius: 9px;
            }
        }
    }

    TouchArea {
        enabled: root.available && !root.pending;
        clicked => { root.toggled(); }
    }
}

component DashboardStat inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> suffix;

    min-width: 150px;
    min-height: 116px;
    max-height: 116px;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 12px;

    VerticalBox {
        padding: 14px;
        spacing: 6px;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 700;
        }

        Text {
            text: root.value;
            color: Theme.text;
            font-size: 28px;
            font-weight: 800;
            overflow: elide;
        }

        Text {
            text: root.suffix;
            color: Theme.text-muted;
            font-size: 11px;
        }
    }
}

component RideStatusLed inherits Rectangle {
    in property <string> status;

    min-width: 14px;
    max-width: 14px;
    background: transparent;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        background: root.status == "Riding" ? Theme.success : root.status == "Paused" ? Theme.warning : Theme.text-muted;
        border-color: root.status == "Riding" ? #6ee7b7 : root.status == "Paused" ? #fde68a : #9ba9ba;
        border-width: 1px;
        border-radius: 7px;
    }
}

component MetricTile inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <string> suffix;
    in property <brush> accent;

    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 12px;
    min-width: 142px;
    min-height: 116px;
    max-height: 116px;

    VerticalBox {
        padding: 14px;
        spacing: 2px;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.value;
            color: root.accent;
            font-size: 36px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text { text: root.suffix; color: Theme.text-muted; font-size: 12px; horizontal-alignment: center; }
    }
}

component PowerMetricTile inherits Rectangle {
    in property <int> primary-value;
    in property <int> secondary-value;
    in property <int> target-value;
    in property <bool> feedback-active;

    private property <int> target-margin: max(10, root.target-value / 20);
    private property <bool> has-target: root.target-value > 0;
    private property <bool> show-feedback: root.feedback-active && root.has-target;
    private property <bool> on-target: root.has-target
        && root.primary-value >= root.target-value - root.target-margin
        && root.primary-value <= root.target-value + root.target-margin;

    background: Theme.surface;
    border-color: !root.show-feedback ? Theme.border : root.on-target ? Theme.success : Theme.danger;
    border-width: root.show-feedback ? 3px : 1px;
    border-radius: 12px;
    min-width: 142px;
    min-height: 116px;
    max-height: 116px;

    VerticalBox {
        padding: 10px;
        spacing: 1px;

        Text {
            text: "POWER";
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.primary-value;
            color: Theme.accent;
            font-size: 36px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            text: "W";
            color: Theme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
        }

        Text {
            text: root.secondary-value > 0
                ? "Secondary  " + root.secondary-value + " W"
                : "Secondary  -- W";
            color: Theme.violet;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
}

component CurrentIntervalPanel inherits Rectangle {
    in property <string> workout-name;
    in property <string> stage-name;
    in property <string> stage-position;
    in property <string> remaining-text;
    in property <string> ride-status;
    in property <int> target-watts;
    in property <int> target-percent;

    min-width: 560px;
    min-height: 202px;
    max-height: 202px;
    background: @linear-gradient(110deg, #14272d 0%, #111925 58%, #151c29 100%);
    border-color: #285b59;
    border-width: 1px;
    border-radius: 14px;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 5px;
        height: parent.height;
        background: Theme.accent;
    }

    HorizontalBox {
        padding: 22px;
        spacing: 24px;

        VerticalBox {
            spacing: 6px;

            HorizontalBox {
                min-height: 28px;
                max-height: 28px;
                spacing: 8px;

                Rectangle {
                    min-width: 96px;
                    max-width: 96px;
                    background: Theme.surface-raised;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 7px;

                    HorizontalBox {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 7px;

                        RideStatusLed { status: root.ride-status; }

                        Text {
                            text: root.ride-status;
                            color: root.ride-status == "Riding" ? Theme.success
                                : root.ride-status == "Paused" ? Theme.warning : Theme.text-secondary;
                            font-size: 11px;
                            font-weight: 800;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle {
                    min-width: 124px;
                    max-width: 124px;
                    background: #162832;
                    border-color: #28505b;
                    border-width: 1px;
                    border-radius: 7px;

                    Text {
                        text: root.stage-position;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            Text {
                text: root.stage-name;
                color: Theme.text;
                font-size: 30px;
                font-weight: 800;
                overflow: elide;
            }

            Text {
                text: root.workout-name;
                color: Theme.text-secondary;
                font-size: 14px;
                overflow: elide;
            }

            Rectangle { background: transparent; vertical-stretch: 1; }

            HorizontalBox {
                min-height: 38px;
                max-height: 38px;
                spacing: 10px;

                Rectangle {
                    min-width: 106px;
                    max-width: 106px;
                    background: #1b3440;
                    border-color: #2c5b68;
                    border-width: 1px;
                    border-radius: 7px;

                    Text {
                        text: root.target-watts + " W";
                        color: Theme.accent;
                        font-size: 17px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    min-width: 92px;
                    max-width: 92px;
                    background: Theme.surface-raised;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 7px;

                    Text {
                        text: root.target-percent + "% FTP";
                        color: Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            min-width: 1px;
            max-width: 1px;
            min-height: 130px;
            max-height: 130px;
            background: #2a4349;
        }

        VerticalBox {
            min-width: 250px;
            spacing: 2px;

            Text {
                text: "STEP REMAINING";
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            Text {
                text: root.remaining-text;
                color: Theme.text;
                font-size: 62px;
                font-weight: 900;
                letter-spacing: 1px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                text: root.ride-status == "Riding" ? "KEEP YOUR RHYTHM"
                    : root.ride-status == "Paused" ? "WORKOUT PAUSED"
                    : root.ride-status == "Finished" ? "RIDE COMPLETE"
                    : "PRESS START WHEN READY";
                color: root.ride-status == "Paused" ? Theme.warning
                    : root.ride-status == "Finished" ? Theme.success : Theme.accent;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
            }
        }
    }
}

component WorkoutStageBlock inherits Rectangle {
    in property <string> stage-name;
    in property <string> duration-text;
    in property <int> target-percent;
    in property <int> target-watts;
    in property <int> progress-percent;
    in property <bool> active;
    in property <bool> completed;

    min-width: 144px;
    min-height: 118px;
    // FTP-relative training zones: recovery, endurance (Zone 2), tempo,
    // sweet spot, threshold, VO2 max, and anaerobic capacity.
    opacity: root.completed ? 0.58 : 1;
    background: root.target-percent <= 55 ? #202a38
        : root.target-percent <= 75 ? #102746
        : root.target-percent <= 87 ? #102e2b
        : root.target-percent <= 94 ? #302a13
        : root.target-percent <= 105 ? #342115
        : root.target-percent <= 120 ? #381a24 : #2d1b3e;
    border-color: root.target-percent <= 55 ? #64748b
        : root.target-percent <= 75 ? #3b82f6
        : root.target-percent <= 87 ? #22c55e
        : root.target-percent <= 94 ? #eab308
        : root.target-percent <= 105 ? #f97316
        : root.target-percent <= 120 ? #ef4444 : #a855f7;
    border-width: root.active ? 3px : 1px;
    border-radius: 9px;

    VerticalBox {
        padding: 12px;
        spacing: 5px;

        Text {
            text: root.stage-name;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.target-watts + " W";
            color: root.active ? Theme.text : Theme.text-secondary;
            font-size: 22px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            text: root.target-percent + "% FTP  /  " + root.duration-text;
            color: Theme.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
        }

        Text {
            text: root.target-percent <= 55 ? "Recovery"
                : root.target-percent <= 75 ? "Zone 2"
                : root.target-percent <= 87 ? "Tempo"
                : root.target-percent <= 94 ? "Sweet Spot"
                : root.target-percent <= 105 ? "Threshold"
                : root.target-percent <= 120 ? "VO2 Max" : "Anaerobic";
            color: root.target-percent <= 55 ? #a8b4c4
                : root.target-percent <= 75 ? #60a5fa
                : root.target-percent <= 87 ? #4ade80
                : root.target-percent <= 94 ? #facc15
                : root.target-percent <= 105 ? #fb923c
                : root.target-percent <= 120 ? #fb7185 : #c084fc;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 7px;
        width: parent.width * root.progress-percent / 100;
        height: 7px;
        background: root.target-percent <= 55 ? #64748b
            : root.target-percent <= 75 ? #2563eb
            : root.target-percent <= 87 ? #16a34a
            : root.target-percent <= 94 ? #ca8a04
            : root.target-percent <= 105 ? #ea580c
            : root.target-percent <= 120 ? #dc2626 : #9333ea;
        border-radius: 3px;
    }
}

component WorkoutTimeline inherits Rectangle {
    in property <[WorkoutStageItem]> stages;
    in property <int> active-stage-offset;
    in property <int> content-width;

    function reveal-active-stage() {
        let stage-left = root.active-stage-offset * 1px;
        let maximum-scroll = max(0px, timeline-scroll.viewport-width - timeline-scroll.visible-width);

        // Flickable positions its content with a negative translation. Align
        // every newly active stage near the left edge instead of waiting until
        // it has moved completely outside the visible area.
        timeline-scroll.viewport-x = -min(maximum-scroll, max(0px, stage-left - 8px));
    }

    changed active-stage-offset => {
        root.reveal-active-stage();
    }

    timeline-scroll := ScrollView {
        viewport-width: max(self.visible-width, root.content-width * 1px);
        viewport-height: self.visible-height;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;

        stage-row := HorizontalBox {
            width: timeline-scroll.viewport-width;
            height: timeline-scroll.viewport-height;
            spacing: 8px;

            for stage in root.stages : WorkoutStageBlock {
                min-width: stage.timeline-width-px * 1px;
                max-width: stage.timeline-width-px * 1px;
                horizontal-stretch: 0;
                stage-name: stage.name;
                duration-text: stage.duration-text;
                target-percent: stage.target-percent;
                target-watts: stage.target-watts;
                progress-percent: stage.progress-percent;
                active: stage.active;
                completed: stage.completed;
            }
        }
    }
}

component RoleStatus inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> status;
    in property <bool> connected;
    in property <bool> error;
    callback disconnect();

    background: Theme.surface;
    border-color: root.error ? #7f3547 : root.connected ? #26634f : Theme.border;
    border-width: 1px;
    border-radius: 12px;
    min-height: 92px;

    HorizontalBox {
        padding: 14px;
        spacing: 12px;

        VerticalBox {
            spacing: 4px;

            Text {
                text: root.label;
                color: Theme.text-secondary;
                font-size: 13px;
            }

            Text {
                text: root.status;
                color: root.error ? Theme.danger : root.connected ? Theme.success : Theme.text-muted;
                font-size: 12px;
                font-weight: 700;
                overflow: elide;
            }
        }

        Text {
            text: root.value;
            color: root.connected ? Theme.accent : Theme.text-muted;
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 76px;
        }

        if root.connected : ActionButton {
            text: "Disconnect";
            min-width: 108px;
            max-width: 108px;
            clicked => { root.disconnect(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Indoor Cycling";
    preferred-width: 1220px;
    preferred-height: 840px;
    min-width: 860px;
    min-height: 620px;

    in property <string> workout-name;
    in property <string> ride-status;
    in property <string> elapsed-text: "00:00";
    in property <int> power-watts: 0;
    in property <int> secondary-power-watts: 0;
    in property <int> target-power-watts: 0;
    in property <int> cadence-rpm: 0;
    in property <int> heart-rate-bpm: 0;
    in property <string> average-power-text: "0 W";
    in property <int> ftp-watts: 200;
    in property <bool> erg-enabled: false;
    in property <bool> erg-available: false;
    in property <bool> erg-pending: false;
    in property <bool> erg-error: false;
    in property <string> erg-status: "Connect a smart trainer";
    in property <string> workout-status: "Ready to start";
    in property <string> current-stage-name: "Warmup";
    in property <string> current-stage-position: "STAGE 1 OF 1";
    in property <string> step-remaining-text: "00:00";
    in property <int> current-target-percent: 0;
    in property <int> timeline-active-stage-offset: 0;
    in property <int> timeline-content-width: 0;
    in property <[WorkoutStageItem]> workout-stages;
    in property <bool> can-go-previous-stage: false;
    in property <bool> can-skip-stage: true;
    in property <[DeviceListItem]> discovered-devices;
    in property <string> device-scan-status: "Ready to scan";
    in property <bool> device-scan-running: false;
    in property <bool> device-scan-error: false;
    in property <bool> device-scan-available: true;
    in property <string> connected-power-id;
    in property <string> connecting-power-id;
    in property <string> power-connection-status: "No primary power source connected";
    in property <bool> power-connection-error: false;
    in property <int> live-power-watts: 0;

    in property <string> connected-secondary-power-id;
    in property <string> connecting-secondary-power-id;
    in property <string> secondary-power-connection-status: "No secondary power source connected";
    in property <bool> secondary-power-connection-error: false;
    in property <int> live-secondary-power-watts: 0;

    in property <string> connected-heart-rate-id;
    in property <string> connecting-heart-rate-id;
    in property <string> heart-rate-connection-status: "No heart rate monitor connected";
    in property <bool> heart-rate-connection-error: false;
    in property <int> live-heart-rate-bpm: 0;

    in property <string> connected-cadence-id;
    in property <string> connecting-cadence-id;
    in property <string> cadence-connection-status: "No cadence source connected";
    in property <bool> cadence-connection-error: false;
    in property <int> live-cadence-rpm: 0;

    in property <string> connected-smart-trainer-id;
    in property <string> connecting-smart-trainer-id;
    in property <string> smart-trainer-connection-status: "No smart trainer connected";
    in property <bool> smart-trainer-connection-error: false;
    in property <bool> finish-dialog-open: false;
    in property <string> finish-error;

    callback start-ride();
    callback pause-ride();
    callback finish-ride();
    callback resume-finish-dialog();
    callback finish-and-discard();
    callback finish-and-save();
    callback set-ftp(int);
    callback toggle-erg-mode();
    callback previous-stage();
    callback skip-stage();
    callback scan-devices();
    callback connect-device(string, int);
    callback disconnect-device(int);
    callback randomize-workout(int, int, int, int, int, int, int);
    callback builder-settings-changed(int, int, int, int, int, int, int);

    private property <int> current-page: 0;
    in-out property <int> draft-length-minutes: 45;
    in-out property <int> draft-workout-type: 3;
    in-out property <int> draft-effort-intensity: 6;
    in-out property <int> draft-recovery-intensity: 6;
    in-out property <int> draft-effort-duration: 6;
    in-out property <int> draft-recovery-duration: 6;
    in-out property <int> draft-variation: 6;

    background: Theme.app-background;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalBox {
        spacing: 0px;

        Rectangle {
            min-height: 68px;
            max-height: 68px;
            background: Theme.header-background;
            border-color: Theme.border;
            border-width: 1px;

            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;

                HorizontalBox {
                    min-width: 250px;
                    spacing: 12px;

                    Rectangle {
                        min-width: 38px;
                        max-width: 38px;
                        min-height: 38px;
                        max-height: 38px;
                        background: Theme.accent-strong;
                        border-radius: 10px;

                        Text {
                            text: "IC";
                            color: #041412;
                            font-size: 15px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalBox {
                        spacing: 0px;

                        Text {
                            text: "Indoor Cycling";
                            color: Theme.text;
                            font-size: 18px;
                            font-weight: 800;
                            vertical-alignment: bottom;
                        }

                        Text {
                            text: root.workout-name;
                            color: Theme.text-muted;
                            font-size: 10px;
                            overflow: elide;
                            vertical-alignment: top;
                        }
                    }
                }

                Rectangle { background: transparent; horizontal-stretch: 1; }

                MenuButton {
                    text: "Dashboard";
                    selected: root.current-page == 0;
                    clicked => { root.current-page = 0; }
                }

                MenuButton {
                    text: "Devices";
                    selected: root.current-page == 1;
                    clicked => { root.current-page = 1; }
                }

                MenuButton {
                    text: "Workout";
                    selected: root.current-page == 2;
                    clicked => { root.current-page = 2; }
                }

                Rectangle { background: transparent; horizontal-stretch: 1; }

                Rectangle {
                    min-width: 98px;
                    max-width: 98px;
                    min-height: 36px;
                    max-height: 36px;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 18px;

                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        RideStatusLed { status: root.ride-status; }

                        Text {
                            text: root.ride-status;
                            color: Theme.text-secondary;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if root.current-page == 0 : dashboard-scroll := ScrollView {
            viewport-width: max(self.visible-width, dashboard.preferred-width);
            viewport-height: max(self.visible-height, dashboard.preferred-height);

            dashboard := VerticalBox {
                width: dashboard-scroll.viewport-width;
                height: dashboard-scroll.viewport-height;
                min-width: 1040px;
                padding: 18px;
                spacing: 12px;

                CurrentIntervalPanel {
                    workout-name: root.workout-name;
                    stage-name: root.current-stage-name;
                    stage-position: root.current-stage-position;
                    remaining-text: root.step-remaining-text;
                    ride-status: root.ride-status;
                    target-watts: root.target-power-watts;
                    target-percent: root.current-target-percent;
                }

                Rectangle {
                    min-height: 54px;
                    max-height: 54px;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;

                    HorizontalBox {
                        padding: 6px;
                        spacing: 10px;

                        VerticalBox {
                            min-width: 180px;
                            spacing: 0px;

                            Text {
                                text: "WORKOUT CONTROLS";
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 800;
                                vertical-alignment: bottom;
                            }

                            Text {
                                text: "Adjust intensity and trainer control";
                                color: Theme.text-muted;
                                font-size: 9px;
                                vertical-alignment: top;
                            }
                        }

                        CompactFtpControl {
                            value: root.ftp-watts;
                            changed(value) => { root.set-ftp(value); }
                        }

                        CompactErgControl {
                            enabled: root.erg-enabled;
                            available: root.erg-available;
                            pending: root.erg-pending;
                            error: root.erg-error;
                            status: root.erg-status;
                            toggled => { root.toggle-erg-mode(); }
                        }

                        Rectangle { background: transparent; horizontal-stretch: 1; }
                    }
                }

                HorizontalBox {
                    min-height: 116px;
                    max-height: 116px;
                    spacing: 10px;

                    PowerMetricTile {
                        primary-value: root.power-watts;
                        secondary-value: root.secondary-power-watts;
                        target-value: root.target-power-watts;
                        feedback-active: root.ride-status == "Riding";
                    }

                    MetricTile {
                        label: "TARGET";
                        value: root.target-power-watts;
                        suffix: "watts";
                        accent: Theme.warning;
                    }

                    MetricTile {
                        label: "CADENCE";
                        value: root.cadence-rpm;
                        suffix: "rpm";
                        accent: Theme.blue;
                    }

                    MetricTile {
                        label: "HEART RATE";
                        value: root.heart-rate-bpm;
                        suffix: "bpm";
                        accent: Theme.danger;
                    }

                    DashboardStat {
                        label: "ELAPSED";
                        value: root.elapsed-text;
                        suffix: "ride time";
                    }

                    DashboardStat {
                        label: "AVG POWER";
                        value: root.average-power-text;
                        suffix: "this ride";
                    }
                }

                Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;
                    min-height: 232px;
                    max-height: 232px;

                    VerticalBox {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalBox {
                            min-height: 42px;
                            max-height: 42px;
                            spacing: 12px;

                            VerticalBox {
                                spacing: 1px;

                                Text {
                                    text: "WORKOUT TIMELINE";
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 800;
                                }

                                Text {
                                    text: root.workout-status;
                                    color: Theme.text-muted;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }

                        }

                        WorkoutTimeline {
                            stages: root.workout-stages;
                            active-stage-offset: root.timeline-active-stage-offset;
                            content-width: root.timeline-content-width;
                        }
                    }
                }
            }
        }

        if root.current-page == 1 : devices-scroll := ScrollView {
            viewport-width: max(self.visible-width, devices-content.preferred-width);
            viewport-height: max(self.visible-height, devices-content.preferred-height);

            devices-content := VerticalBox {
                width: devices-scroll.viewport-width;
                // Fill a larger window while retaining the preferred height as the
                // scrollable minimum when there are many devices.
                height: devices-scroll.viewport-height;
                padding: 24px;
                spacing: 18px;

                Text {
                    text: "Bluetooth Devices";
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 800;
                }

                Text {
                    text: "Assign Bluetooth devices to ride data and trainer roles.";
                    color: Theme.text-secondary;
                    font-size: 15px;
                }

                HorizontalBox {
                    spacing: 16px;

                    ActionButton {
                        text: root.device-scan-running ? "Scanning..." : "Scan for devices";
                        enabled: root.device-scan-available && !root.device-scan-running;
                        variant: 1;
                        max-width: 190px;
                        clicked => { root.scan-devices(); }
                    }

                    Text {
                        text: root.device-scan-status;
                        color: root.device-scan-error ? Theme.danger : Theme.text-muted;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "ASSIGNED ROLES";
                    color: Theme.text-secondary;
                    font-size: 13px;
                    font-weight: 800;
                }

                HorizontalBox {
                    spacing: 18px;

                    RoleStatus {
                        label: "Primary Power";
                        value: root.live-power-watts > 0 ? root.live-power-watts + " W" : "-- W";
                        status: root.power-connection-status;
                        connected: root.connected-power-id != "";
                        error: root.power-connection-error;
                        disconnect => { root.disconnect-device(0); }
                    }

                    RoleStatus {
                        label: "Smart Trainer";
                        value: root.connected-smart-trainer-id != "" ? "Ready" : "--";
                        status: root.smart-trainer-connection-status;
                        connected: root.connected-smart-trainer-id != "";
                        error: root.smart-trainer-connection-error;
                        disconnect => { root.disconnect-device(4); }
                    }

                    RoleStatus {
                        label: "Secondary Power";
                        value: root.live-secondary-power-watts > 0
                            ? root.live-secondary-power-watts + " W"
                            : "-- W";
                        status: root.secondary-power-connection-status;
                        connected: root.connected-secondary-power-id != "";
                        error: root.secondary-power-connection-error;
                        disconnect => { root.disconnect-device(1); }
                    }
                }

                HorizontalBox {
                    spacing: 18px;

                    RoleStatus {
                        label: "Heart Rate";
                        value: root.live-heart-rate-bpm > 0 ? root.live-heart-rate-bpm + " bpm" : "-- bpm";
                        status: root.heart-rate-connection-status;
                        connected: root.connected-heart-rate-id != "";
                        error: root.heart-rate-connection-error;
                        disconnect => { root.disconnect-device(2); }
                    }

                    RoleStatus {
                        label: "RPM";
                        value: root.live-cadence-rpm > 0 ? root.live-cadence-rpm + " rpm" : "-- rpm";
                        status: root.cadence-connection-status;
                        connected: root.connected-cadence-id != "";
                        error: root.cadence-connection-error;
                        disconnect => { root.disconnect-device(3); }
                    }
                }

                Text {
                    text: "NEARBY DEVICES";
                    color: Theme.text-secondary;
                    font-size: 13px;
                    font-weight: 800;
                }

                if root.discovered-devices.length == 0 : Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;
                    min-height: 120px;

                    Text {
                        text: root.device-scan-running
                            ? "Listening for nearby Bluetooth devices..."
                            : "No compatible devices found yet.";
                        color: Theme.text-muted;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for device in root.discovered-devices : Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;
                    min-height: 132px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalBox {
                            spacing: 18px;

                            VerticalBox {
                                spacing: 6px;

                                Text {
                                    text: device.name;
                                    color: Theme.text;
                                    font-size: 18px;
                                    font-weight: 800;
                                }

                                Text {
                                    text: device.capabilities;
                                    color: Theme.text-secondary;
                                    font-size: 14px;
                                }
                            }

                            Text {
                                text: device.signal;
                                color: Theme.text-muted;
                                font-size: 14px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                min-width: 100px;
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;

                            if device.supports-power : ActionButton {
                                text: root.connected-power-id == device.id
                                    ? "Disconnect Power"
                                    : root.connecting-power-id == device.id
                                        ? "Connecting..."
                                        : "Primary Power";
                                enabled: root.connecting-power-id == "";
                                clicked => {
                                    if root.connected-power-id == device.id {
                                        root.disconnect-device(0);
                                    } else if root.connecting-power-id == "" {
                                        root.connect-device(device.id, 0);
                                    }
                                }
                            }

                            if device.supports-power : ActionButton {
                                text: root.connected-secondary-power-id == device.id
                                    ? "Disconnect Secondary"
                                    : root.connecting-secondary-power-id == device.id
                                        ? "Connecting..."
                                        : "Secondary Power";
                                enabled: root.connecting-secondary-power-id == "";
                                clicked => {
                                    if root.connected-secondary-power-id == device.id {
                                        root.disconnect-device(1);
                                    } else if root.connecting-secondary-power-id == "" {
                                        root.connect-device(device.id, 1);
                                    }
                                }
                            }

                            if device.supports-heart-rate : ActionButton {
                                text: root.connected-heart-rate-id == device.id
                                    ? "Disconnect HR"
                                    : root.connecting-heart-rate-id == device.id
                                        ? "Connecting..."
                                        : "Heart Rate";
                                enabled: root.connecting-heart-rate-id == "";
                                clicked => {
                                    if root.connected-heart-rate-id == device.id {
                                        root.disconnect-device(2);
                                    } else if root.connecting-heart-rate-id == "" {
                                        root.connect-device(device.id, 2);
                                    }
                                }
                            }

                            if device.supports-cadence : ActionButton {
                                text: root.connected-cadence-id == device.id
                                    ? "Disconnect RPM"
                                    : root.connecting-cadence-id == device.id
                                        ? "Connecting..."
                                        : "RPM";
                                enabled: root.connecting-cadence-id == "";
                                clicked => {
                                    if root.connected-cadence-id == device.id {
                                        root.disconnect-device(3);
                                    } else if root.connecting-cadence-id == "" {
                                        root.connect-device(device.id, 3);
                                    }
                                }
                            }

                            if device.supports-smart-trainer : ActionButton {
                                text: root.connected-smart-trainer-id == device.id
                                    ? "Disconnect Trainer"
                                    : root.connecting-smart-trainer-id == device.id
                                        ? "Connecting..."
                                        : "Smart Trainer";
                                enabled: root.connecting-smart-trainer-id == "";
                                clicked => {
                                    if root.connected-smart-trainer-id == device.id {
                                        root.disconnect-device(4);
                                    } else if root.connecting-smart-trainer-id == "" {
                                        root.connect-device(device.id, 4);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.current-page == 2 : workout-scroll := ScrollView {
            viewport-width: max(self.visible-width, workout-content.preferred-width);
            viewport-height: max(self.visible-height, workout-content.preferred-height);

            workout-content := VerticalBox {
                width: workout-scroll.viewport-width;
                height: workout-scroll.viewport-height;
                padding: 24px;
                spacing: 18px;

                Text {
                    text: "Workout Builder";
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 800;
                }

                Text {
                    text: "Build a varied interval session around your FTP. A warmup and cooldown are always included.";
                    color: Theme.text-secondary;
                    font-size: 15px;
                }

                FtpControl {
                    value: root.ftp-watts;
                    changed(value) => { root.set-ftp(value); }
                }

                Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;

                    VerticalBox {
                        padding: 20px;
                        spacing: 16px;

                        VerticalBox {
                            spacing: 8px;
                            Text { text: "WORKOUT TYPE"; color: Theme.text-secondary; font-size: 12px; font-weight: 800; }
                            HorizontalBox {
                                spacing: 6px;
                                WorkoutTypeButton { text: "Recovery"; selected: root.draft-workout-type == 0; clicked => { root.draft-workout-type = 0; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                                WorkoutTypeButton { text: "Endurance"; selected: root.draft-workout-type == 1; clicked => { root.draft-workout-type = 1; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                                WorkoutTypeButton { text: "Tempo"; selected: root.draft-workout-type == 2; clicked => { root.draft-workout-type = 2; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                                WorkoutTypeButton { text: "Sweet spot"; selected: root.draft-workout-type == 3; clicked => { root.draft-workout-type = 3; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                                WorkoutTypeButton { text: "Threshold"; selected: root.draft-workout-type == 4; clicked => { root.draft-workout-type = 4; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                            }
                            HorizontalBox {
                                spacing: 6px;
                                WorkoutTypeButton { text: "Over-under"; selected: root.draft-workout-type == 5; clicked => { root.draft-workout-type = 5; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                                WorkoutTypeButton { text: "VO2 max"; selected: root.draft-workout-type == 6; clicked => { root.draft-workout-type = 6; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                                WorkoutTypeButton { text: "Sprinting"; selected: root.draft-workout-type == 7; clicked => { root.draft-workout-type = 7; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                                WorkoutTypeButton { text: "Microbursts"; selected: root.draft-workout-type == 8; clicked => { root.draft-workout-type = 8; root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation); } }
                            }
                        }

                        BuilderSliderRow {
                            label: "Total length";
                            value: root.draft-length-minutes;
                            minimum-value: 15;
                            maximum-value: 180;
                            step-value: 5;
                            suffix: " min";
                            changed(value) => {
                                root.draft-length-minutes = value;
                                root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation);
                            }
                        }

                        BuilderSliderRow {
                            label: "Effort intensity";
                            value: root.draft-effort-intensity;
                            changed(value) => {
                                root.draft-effort-intensity = value;
                                root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation);
                            }
                        }

                        BuilderSliderRow {
                            label: "Recovery intensity";
                            value: root.draft-recovery-intensity;
                            changed(value) => {
                                root.draft-recovery-intensity = value;
                                root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation);
                            }
                        }

                        BuilderSliderRow {
                            label: "Effort duration";
                            value: root.draft-effort-duration;
                            changed(value) => {
                                root.draft-effort-duration = value;
                                root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation);
                            }
                        }

                        BuilderSliderRow {
                            label: "Recovery duration";
                            value: root.draft-recovery-duration;
                            changed(value) => {
                                root.draft-recovery-duration = value;
                                root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation);
                            }
                        }

                        BuilderSliderRow {
                            label: "Variation";
                            value: root.draft-variation;
                            changed(value) => {
                                root.draft-variation = value;
                                root.builder-settings-changed(root.draft-length-minutes, root.draft-workout-type, root.draft-effort-intensity, root.draft-recovery-intensity, root.draft-effort-duration, root.draft-recovery-duration, root.draft-variation);
                            }
                        }

                        ActionButton {
                            text: "Randomize and activate workout";
                            variant: 1;
                            max-width: 290px;
                            clicked => {
                                root.randomize-workout(
                                    root.draft-length-minutes,
                                    root.draft-workout-type,
                                    root.draft-effort-intensity,
                                    root.draft-recovery-intensity,
                                    root.draft-effort-duration,
                                    root.draft-recovery-duration,
                                    root.draft-variation
                                );
                            }
                        }
                    }
                }

                Text {
                    text: "ACTIVE WORKOUT  •  " + root.workout-name;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 800;
                }

                Rectangle {
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;
                    min-height: 150px;

                    preview-scroll := ScrollView {
                        viewport-width: max(self.visible-width, root.timeline-content-width * 1px + 32px);
                        viewport-height: self.visible-height;
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                        preview-row := HorizontalBox {
                            width: preview-scroll.viewport-width;
                            height: preview-scroll.viewport-height;
                            padding: 16px;
                            spacing: 8px;
                            for stage in root.workout-stages : WorkoutStageBlock {
                                min-width: stage.timeline-width-px * 1px;
                                max-width: stage.timeline-width-px * 1px;
                                horizontal-stretch: 0;
                                stage-name: stage.name;
                                duration-text: stage.duration-text;
                                target-percent: stage.target-percent;
                                target-watts: stage.target-watts;
                                progress-percent: 0;
                                active: false;
                                completed: false;
                            }
                        }
                    }
                }
            }
        }

        if root.current-page == 0 : Rectangle {
            min-height: 72px;
            max-height: 72px;
            background: Theme.header-background;
            border-color: Theme.border;
            border-width: 1px;

            HorizontalBox {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 10px;

                ActionButton {
                    text: root.ride-status == "Paused" ? "Resume ride"
                        : root.ride-status == "Riding" ? "Riding"
                        : root.ride-status == "Finished" ? "Ride complete" : "Start ride";
                    variant: 1;
                    enabled: root.ride-status != "Riding" && root.ride-status != "Finished";
                    max-width: 150px;
                    clicked => { root.start-ride(); }
                }

                ActionButton {
                    text: "Pause";
                    enabled: root.ride-status == "Riding";
                    max-width: 120px;
                    clicked => { root.pause-ride(); }
                }

                ActionButton {
                    text: "Finish";
                    variant: 2;
                    max-width: 120px;
                    clicked => { root.finish-ride(); }
                }

                Rectangle { background: transparent; horizontal-stretch: 1; }

                ActionButton {
                    text: "Previous stage";
                    enabled: root.can-go-previous-stage;
                    max-width: 150px;
                    clicked => { root.previous-stage(); }
                }

                ActionButton {
                    text: "Skip stage";
                    enabled: root.can-skip-stage;
                    max-width: 140px;
                    clicked => { root.skip-stage(); }
                }
            }
        }
    }

    if root.finish-dialog-open : Rectangle {
        width: root.width;
        height: root.height;
        background: #020408cc;

        TouchArea { }

        Rectangle {
            width: min(560px, root.width - 48px);
            min-height: 240px;
            max-height: 292px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-raised;
            border-color: Theme.border-strong;
            border-width: 1px;
            border-radius: 14px;

            VerticalBox {
                padding: 22px;
                spacing: 14px;

                Text {
                    text: "Finish workout?";
                    color: Theme.text;
                    font-size: 24px;
                    font-weight: 800;
                }

                Text {
                    text: "Save a FIT activity file for upload, discard this ride, or resume where you left off.";
                    color: Theme.text-secondary;
                    font-size: 15px;
                    wrap: word-wrap;
                }

                Text {
                    text: root.finish-error;
                    color: Theme.danger;
                    font-size: 13px;
                    min-height: root.finish-error == "" ? 0px : 20px;
                    visible: root.finish-error != "";
                    wrap: word-wrap;
                }

                Rectangle {
                    background: transparent;
                    vertical-stretch: 1;
                }

                HorizontalBox {
                    spacing: 10px;

                    ActionButton {
                        text: "Resume";
                        clicked => { root.resume-finish-dialog(); }
                    }

                    ActionButton {
                        text: "Finish and discard";
                        variant: 2;
                        clicked => { root.finish-and-discard(); }
                    }

                    ActionButton {
                        text: "Finish and save";
                        variant: 1;
                        clicked => { root.finish-and-save(); }
                    }
                }
            }
        }
    }
}
