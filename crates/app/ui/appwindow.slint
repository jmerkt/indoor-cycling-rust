import { ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct DeviceListItem {
    id: string,
    name: string,
    capabilities: string,
    signal: string,
    supports-power: bool,
    supports-heart-rate: bool,
    supports-cadence: bool,
    supports-smart-trainer: bool,
}

export struct WorkoutStageItem {
    name: string,
    duration-secs: int,
    duration-text: string,
    target-percent: int,
    target-watts: int,
    progress-percent: int,
    active: bool,
    completed: bool,
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 110px;
    min-height: 40px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.55;
    background: touch.pressed && root.enabled ? #d8dde3 : touch.has-hover && root.enabled ? #eef1f4 : white;
    border-color: #c7ced6;
    border-width: 1px;
    border-radius: 5px;

    Text {
        text: root.text;
        color: #17202a;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    min-width: 120px;
    min-height: 42px;
    max-height: 42px;
    background: root.selected ? #0f766e : touch.has-hover ? #eef1f4 : transparent;
    border-radius: 5px;

    Text {
        text: root.text;
        color: root.selected ? white : #17202a;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component FtpStepButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    opacity: root.enabled ? 1 : 0.4;
    background: touch.pressed && root.enabled
        ? #0d5f59
        : touch.has-hover && root.enabled ? #0f766e : #e6f4f2;
    border-color: #9ccbc6;
    border-width: 1px;
    border-radius: 6px;

    Text {
        text: root.text;
        color: touch.has-hover && root.enabled ? white : #0f766e;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component FtpControl inherits Rectangle {
    in property <int> value;
    callback changed(int);

    min-width: 250px;
    max-width: 250px;
    min-height: 74px;
    max-height: 74px;
    background: white;
    border-color: #cbd5df;
    border-width: 1px;
    border-radius: 8px;

    HorizontalBox {
        padding: 12px;
        spacing: 10px;

        VerticalBox {
            spacing: 1px;

            Text {
                text: "FTP";
                color: #53616f;
                font-size: 12px;
                font-weight: 600;
            }

            Text {
                text: root.value + " W";
                color: #17202a;
                font-size: 24px;
                font-weight: 800;
            }
        }

        FtpStepButton {
            text: "-";
            enabled: root.value > 50;
            clicked => { root.changed(max(50, root.value - 5)); }
        }

        FtpStepButton {
            text: "+";
            enabled: root.value < 600;
            clicked => { root.changed(min(600, root.value + 5)); }
        }
    }
}

component ErgControl inherits Rectangle {
    in property <bool> enabled;
    in property <bool> available;
    in property <bool> pending;
    in property <bool> error;
    in property <string> status;
    callback toggled();

    min-width: 250px;
    max-width: 250px;
    min-height: 74px;
    max-height: 74px;
    background: root.enabled ? #ecfdf5 : white;
    border-color: root.enabled ? #0f766e : #cbd5df;
    border-width: root.enabled ? 2px : 1px;
    border-radius: 8px;

    HorizontalBox {
        padding: 12px;
        spacing: 10px;

        VerticalBox {
            spacing: 2px;

            Text {
                text: "ERG Mode";
                color: #17202a;
                font-size: 15px;
                font-weight: 700;
            }

            Text {
                text: root.status;
                color: root.error ? #be123c : #53616f;
                font-size: 11px;
                overflow: elide;
            }
        }

        Rectangle {
            min-width: 72px;
            max-width: 72px;
            min-height: 38px;
            max-height: 38px;
            opacity: root.available && !root.pending ? 1 : 0.45;
            background: root.enabled ? #0f766e : #e6ebf0;
            border-color: root.enabled ? #0f766e : #aeb8c2;
            border-width: 1px;
            border-radius: 19px;

            Text {
                text: root.pending ? "..." : root.enabled ? "ON" : "OFF";
                color: root.enabled ? white : #53616f;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                enabled: root.available && !root.pending;
                clicked => { root.toggled(); }
            }
        }
    }
}

component MetricTile inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <string> suffix;
    in property <brush> accent;

    background: #fbfcfd;
    border-color: #d8dde3;
    border-width: 1px;
    border-radius: 8px;

    VerticalBox {
        padding: 18px;
        spacing: 10px;

        Text {
            text: root.label;
            color: #53616f;
            font-size: 14px;
        }

        Text {
            text: root.value;
            color: root.accent;
            font-size: 46px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            text: root.suffix;
            color: #53616f;
            font-size: 15px;
            horizontal-alignment: center;
        }
    }
}

component PowerMetricTile inherits Rectangle {
    in property <int> primary-value;
    in property <int> secondary-value;

    background: #fbfcfd;
    border-color: #d8dde3;
    border-width: 1px;
    border-radius: 8px;

    VerticalBox {
        padding: 18px;
        spacing: 8px;

        Text {
            text: "Power";
            color: #53616f;
            font-size: 14px;
        }

        Text {
            text: root.primary-value;
            color: #0f766e;
            font-size: 46px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            text: "W";
            color: #53616f;
            font-size: 15px;
            horizontal-alignment: center;
        }

        Text {
            text: root.secondary-value > 0
                ? "Secondary  " + root.secondary-value + " W"
                : "Secondary  -- W";
            color: #7c3aed;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
}

component WorkoutStageBlock inherits Rectangle {
    in property <string> stage-name;
    in property <string> duration-text;
    in property <int> target-percent;
    in property <int> target-watts;
    in property <int> progress-percent;
    in property <bool> active;
    in property <bool> completed;

    min-width: 112px;
    min-height: 118px;
    background: root.active ? #ecfdf5 : root.completed ? #f0fdfa : #f8fafc;
    border-color: root.active ? #0f766e : #d8dde3;
    border-width: root.active ? 3px : 1px;
    border-radius: 6px;

    VerticalBox {
        padding: 12px;
        spacing: 5px;

        Text {
            text: root.stage-name;
            color: #17202a;
            font-size: 15px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.target-watts + " W";
            color: root.active ? #0f766e : #334155;
            font-size: 22px;
            font-weight: 800;
            horizontal-alignment: center;
        }

        Text {
            text: root.target-percent + "% FTP  /  " + root.duration-text;
            color: #64748b;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 7px;
        width: parent.width * root.progress-percent / 100;
        height: 7px;
        background: #14b8a6;
        border-radius: 3px;
    }
}

component RoleStatus inherits Rectangle {
    in property <string> label;
    in property <string> status;
    in property <string> value;
    in property <bool> error;
    in property <bool> connected;
    callback disconnect();

    background: white;
    border-color: root.error ? #be123c : #d8dde3;
    border-width: 1px;
    border-radius: 8px;
    min-height: 68px;

    HorizontalBox {
        padding: 14px;
        spacing: 16px;

        VerticalBox {
            spacing: 4px;

            Text {
                text: root.label;
                color: #53616f;
                font-size: 13px;
            }

            Text {
                text: root.status;
                color: root.error ? #be123c : #17202a;
                font-size: 15px;
                font-weight: 600;
            }
        }

        Text {
            text: root.value;
            color: #0f766e;
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
            min-width: 110px;
        }

        if root.connected : ActionButton {
            text: "Disconnect";
            max-width: 110px;
            clicked => { root.disconnect(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "Indoor Cycling";
    preferred-width: 900px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 480px;

    in property <string> workout-name;
    in property <string> ride-status;
    in property <string> current-step: "No active step";
    in property <string> elapsed-text: "00:00";
    in property <int> power-watts: 0;
    in property <int> secondary-power-watts: 0;
    in property <int> target-power-watts: 0;
    in property <int> cadence-rpm: 0;
    in property <int> heart-rate-bpm: 0;
    in property <string> average-power-text: "0 W";
    in property <int> ftp-watts: 200;
    in property <bool> erg-enabled: false;
    in property <bool> erg-available: false;
    in property <bool> erg-pending: false;
    in property <bool> erg-error: false;
    in property <string> erg-status: "Connect a smart trainer";
    in property <string> workout-status: "Ready to start";
    in property <[WorkoutStageItem]> workout-stages;
    in property <bool> can-go-previous-stage: false;
    in property <bool> can-skip-stage: true;
    in property <[DeviceListItem]> discovered-devices;
    in property <string> device-scan-status: "Ready to scan";
    in property <bool> device-scan-running: false;
    in property <bool> device-scan-error: false;
    in property <bool> device-scan-available: true;
    in property <string> connected-power-id;
    in property <string> connecting-power-id;
    in property <string> power-connection-status: "No primary power source connected";
    in property <bool> power-connection-error: false;
    in property <int> live-power-watts: 0;

    in property <string> connected-secondary-power-id;
    in property <string> connecting-secondary-power-id;
    in property <string> secondary-power-connection-status: "No secondary power source connected";
    in property <bool> secondary-power-connection-error: false;
    in property <int> live-secondary-power-watts: 0;

    in property <string> connected-heart-rate-id;
    in property <string> connecting-heart-rate-id;
    in property <string> heart-rate-connection-status: "No heart rate monitor connected";
    in property <bool> heart-rate-connection-error: false;
    in property <int> live-heart-rate-bpm: 0;

    in property <string> connected-cadence-id;
    in property <string> connecting-cadence-id;
    in property <string> cadence-connection-status: "No cadence source connected";
    in property <bool> cadence-connection-error: false;
    in property <int> live-cadence-rpm: 0;

    in property <string> connected-smart-trainer-id;
    in property <string> connecting-smart-trainer-id;
    in property <string> smart-trainer-connection-status: "No smart trainer connected";
    in property <bool> smart-trainer-connection-error: false;

    callback start-ride();
    callback pause-ride();
    callback reset-ride();
    callback set-ftp(int);
    callback toggle-erg-mode();
    callback previous-stage();
    callback skip-stage();
    callback scan-devices();
    callback connect-device(string, int);
    callback disconnect-device(int);

    private property <int> current-page: 0;

    background: #f7f8fa;

    VerticalBox {
        spacing: 0px;

        Rectangle {
            min-height: 62px;
            max-height: 62px;
            background: white;
            border-color: #d8dde3;
            border-width: 1px;

            HorizontalBox {
                padding: 10px;
                spacing: 10px;

                Text {
                    text: "Indoor Cycling";
                    color: #17202a;
                    font-size: 22px;
                    font-weight: 700;
                    min-width: 220px;
                    vertical-alignment: center;
                }

                MenuButton {
                    text: "Dashboard";
                    selected: root.current-page == 0;
                    clicked => { root.current-page = 0; }
                }

                MenuButton {
                    text: "Devices";
                    selected: root.current-page == 1;
                    clicked => { root.current-page = 1; }
                }
            }
        }

        if root.current-page == 0 : dashboard-scroll := ScrollView {
            viewport-width: max(self.visible-width, dashboard.preferred-width);
            viewport-height: max(self.visible-height, dashboard.preferred-height);

            dashboard := VerticalBox {
                width: dashboard-scroll.viewport-width;
                // Keep the dashboard as large as the visible viewport. Without an
                // explicit height it remains at its content height, which leaves a
                // blank area when the window is enlarged.
                height: dashboard-scroll.viewport-height;
                padding: 24px;
                spacing: 18px;

                HorizontalBox {
                    spacing: 18px;

                    VerticalBox {
                        spacing: 4px;
                        Text {
                            text: root.workout-name;
                            color: #17202a;
                            font-size: 30px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.ride-status;
                            color: #53616f;
                            font-size: 16px;
                        }
                    }

                    FtpControl {
                        value: root.ftp-watts;
                        changed(value) => { root.set-ftp(value); }
                    }

                    ErgControl {
                        enabled: root.erg-enabled;
                        available: root.erg-available;
                        pending: root.erg-pending;
                        error: root.erg-error;
                        status: root.erg-status;
                        toggled => { root.toggle-erg-mode(); }
                    }
                }

                Rectangle {
                    background: white;
                    border-color: #d8dde3;
                    border-width: 1px;
                    border-radius: 8px;
                    min-height: 192px;
                    vertical-stretch: 1;

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: root.workout-status;
                            color: #334155;
                            font-size: 15px;
                            font-weight: 600;
                        }

                        HorizontalBox {
                            spacing: 6px;

                            for stage in root.workout-stages : WorkoutStageBlock {
                                horizontal-stretch: stage.duration-secs;
                                stage-name: stage.name;
                                duration-text: stage.duration-text;
                                target-percent: stage.target-percent;
                                target-watts: stage.target-watts;
                                progress-percent: stage.progress-percent;
                                active: stage.active;
                                completed: stage.completed;
                            }
                        }
                    }
                }

                Rectangle {
                    background: white;
                    border-color: #d8dde3;
                    border-width: 1px;
                    border-radius: 8px;
                    min-height: 250px;
                    vertical-stretch: 2;

                    HorizontalBox {
                        padding: 24px;
                        spacing: 24px;

                        PowerMetricTile {
                            primary-value: root.power-watts;
                            secondary-value: root.secondary-power-watts;
                        }

                        MetricTile {
                            label: "Target";
                            value: root.target-power-watts;
                            suffix: "W";
                            accent: #b45309;
                        }

                        MetricTile {
                            label: "Cadence";
                            value: root.cadence-rpm;
                            suffix: "rpm";
                            accent: #2563eb;
                        }

                        MetricTile {
                            label: "Heart Rate";
                            value: root.heart-rate-bpm;
                            suffix: "bpm";
                            accent: #be123c;
                        }
                    }
                }

                HorizontalBox {
                    spacing: 18px;
                    vertical-stretch: 1;

                    Rectangle {
                        background: white;
                        border-color: #d8dde3;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 18px;
                            spacing: 6px;

                            Text {
                                text: "Elapsed";
                                color: #53616f;
                                font-size: 14px;
                            }
                            Text {
                                text: root.elapsed-text;
                                color: #17202a;
                                font-size: 34px;
                                font-weight: 700;
                            }
                        }
                    }

                    Rectangle {
                        background: white;
                        border-color: #d8dde3;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 18px;
                            spacing: 6px;

                            Text {
                                text: "Current Step";
                                color: #53616f;
                                font-size: 14px;
                            }
                            Text {
                                text: root.current-step;
                                color: #17202a;
                                font-size: 24px;
                                font-weight: 700;
                            }
                        }
                    }

                    Rectangle {
                        background: white;
                        border-color: #d8dde3;
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 18px;
                            spacing: 6px;

                            Text {
                                text: "Average Power";
                                color: #53616f;
                                font-size: 14px;
                            }
                            Text {
                                text: root.average-power-text;
                                color: #17202a;
                                font-size: 24px;
                                font-weight: 700;
                            }
                        }
                    }
                }
            }
        }

        if root.current-page == 1 : devices-scroll := ScrollView {
            viewport-width: max(self.visible-width, devices-content.preferred-width);
            viewport-height: max(self.visible-height, devices-content.preferred-height);

            devices-content := VerticalBox {
                width: devices-scroll.viewport-width;
                // Fill a larger window while retaining the preferred height as the
                // scrollable minimum when there are many devices.
                height: devices-scroll.viewport-height;
                padding: 24px;
                spacing: 18px;

                Text {
                    text: "Bluetooth Devices";
                    color: #17202a;
                    font-size: 30px;
                    font-weight: 700;
                }

                Text {
                    text: "Assign Bluetooth devices to ride data and trainer roles.";
                    color: #53616f;
                    font-size: 16px;
                }

                HorizontalBox {
                    spacing: 16px;

                    ActionButton {
                        text: root.device-scan-running ? "Scanning..." : "Scan for devices";
                        enabled: root.device-scan-available && !root.device-scan-running;
                        max-width: 190px;
                        clicked => { root.scan-devices(); }
                    }

                    Text {
                        text: root.device-scan-status;
                        color: root.device-scan-error ? #be123c : #53616f;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Assigned Roles";
                    color: #17202a;
                    font-size: 20px;
                    font-weight: 700;
                }

                RoleStatus {
                    label: "Primary Power";
                    status: root.power-connection-status;
                    value: root.live-power-watts > 0 ? root.live-power-watts + " W" : "-- W";
                    error: root.power-connection-error;
                    connected: root.connected-power-id != "";
                    disconnect => { root.disconnect-device(0); }
                }

                RoleStatus {
                    label: "Secondary Power";
                    status: root.secondary-power-connection-status;
                    value: root.live-secondary-power-watts > 0
                        ? root.live-secondary-power-watts + " W"
                        : "-- W";
                    error: root.secondary-power-connection-error;
                    connected: root.connected-secondary-power-id != "";
                    disconnect => { root.disconnect-device(1); }
                }

                RoleStatus {
                    label: "Heart Rate";
                    status: root.heart-rate-connection-status;
                    value: root.live-heart-rate-bpm > 0 ? root.live-heart-rate-bpm + " bpm" : "-- bpm";
                    error: root.heart-rate-connection-error;
                    connected: root.connected-heart-rate-id != "";
                    disconnect => { root.disconnect-device(2); }
                }

                RoleStatus {
                    label: "RPM";
                    status: root.cadence-connection-status;
                    value: root.live-cadence-rpm > 0 ? root.live-cadence-rpm + " rpm" : "-- rpm";
                    error: root.cadence-connection-error;
                    connected: root.connected-cadence-id != "";
                    disconnect => { root.disconnect-device(3); }
                }

                RoleStatus {
                    label: "Smart Trainer";
                    status: root.smart-trainer-connection-status;
                    value: root.connected-smart-trainer-id != "" ? "Connected" : "--";
                    error: root.smart-trainer-connection-error;
                    connected: root.connected-smart-trainer-id != "";
                    disconnect => { root.disconnect-device(4); }
                }

                if root.discovered-devices.length == 0 : Rectangle {
                    background: white;
                    border-color: #d8dde3;
                    border-width: 1px;
                    border-radius: 8px;
                    min-height: 120px;

                    Text {
                        text: root.device-scan-running
                            ? "Listening for nearby Bluetooth devices..."
                            : "No compatible devices found yet.";
                        color: #53616f;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for device in root.discovered-devices : Rectangle {
                    background: white;
                    border-color: #d8dde3;
                    border-width: 1px;
                    border-radius: 8px;
                    min-height: 132px;

                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalBox {
                            spacing: 18px;

                            VerticalBox {
                                spacing: 6px;

                                Text {
                                    text: device.name;
                                    color: #17202a;
                                    font-size: 18px;
                                    font-weight: 700;
                                }

                                Text {
                                    text: device.capabilities;
                                    color: #53616f;
                                    font-size: 14px;
                                }
                            }

                            Text {
                                text: device.signal;
                                color: #53616f;
                                font-size: 14px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                min-width: 100px;
                            }
                        }

                        HorizontalBox {
                            spacing: 8px;

                            if device.supports-power : ActionButton {
                                text: root.connected-power-id == device.id
                                    ? "Disconnect Power"
                                    : root.connecting-power-id == device.id
                                        ? "Connecting..."
                                        : "Primary Power";
                                enabled: root.connecting-power-id == "";
                                clicked => {
                                    if root.connected-power-id == device.id {
                                        root.disconnect-device(0);
                                    } else if root.connecting-power-id == "" {
                                        root.connect-device(device.id, 0);
                                    }
                                }
                            }

                            if device.supports-power : ActionButton {
                                text: root.connected-secondary-power-id == device.id
                                    ? "Disconnect Secondary"
                                    : root.connecting-secondary-power-id == device.id
                                        ? "Connecting..."
                                        : "Secondary Power";
                                enabled: root.connecting-secondary-power-id == "";
                                clicked => {
                                    if root.connected-secondary-power-id == device.id {
                                        root.disconnect-device(1);
                                    } else if root.connecting-secondary-power-id == "" {
                                        root.connect-device(device.id, 1);
                                    }
                                }
                            }

                            if device.supports-heart-rate : ActionButton {
                                text: root.connected-heart-rate-id == device.id
                                    ? "Disconnect HR"
                                    : root.connecting-heart-rate-id == device.id
                                        ? "Connecting..."
                                        : "Heart Rate";
                                enabled: root.connecting-heart-rate-id == "";
                                clicked => {
                                    if root.connected-heart-rate-id == device.id {
                                        root.disconnect-device(2);
                                    } else if root.connecting-heart-rate-id == "" {
                                        root.connect-device(device.id, 2);
                                    }
                                }
                            }

                            if device.supports-cadence : ActionButton {
                                text: root.connected-cadence-id == device.id
                                    ? "Disconnect RPM"
                                    : root.connecting-cadence-id == device.id
                                        ? "Connecting..."
                                        : "RPM";
                                enabled: root.connecting-cadence-id == "";
                                clicked => {
                                    if root.connected-cadence-id == device.id {
                                        root.disconnect-device(3);
                                    } else if root.connecting-cadence-id == "" {
                                        root.connect-device(device.id, 3);
                                    }
                                }
                            }

                            if device.supports-smart-trainer : ActionButton {
                                text: root.connected-smart-trainer-id == device.id
                                    ? "Disconnect Trainer"
                                    : root.connecting-smart-trainer-id == device.id
                                        ? "Connecting..."
                                        : "Smart Trainer";
                                enabled: root.connecting-smart-trainer-id == "";
                                clicked => {
                                    if root.connected-smart-trainer-id == device.id {
                                        root.disconnect-device(4);
                                    } else if root.connecting-smart-trainer-id == "" {
                                        root.connect-device(device.id, 4);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.current-page == 0 : Rectangle {
            min-height: 64px;
            max-height: 64px;
            background: #f7f8fa;
            border-color: #d8dde3;
            border-width: 1px;

            HorizontalBox {
                padding: 10px;
                spacing: 12px;

                ActionButton {
                    text: "Start";
                    clicked => { root.start-ride(); }
                }

                ActionButton {
                    text: "Pause";
                    clicked => { root.pause-ride(); }
                }

                ActionButton {
                    text: "Reset";
                    clicked => { root.reset-ride(); }
                }

                ActionButton {
                    text: "Previous Stage";
                    enabled: root.can-go-previous-stage;
                    clicked => { root.previous-stage(); }
                }

                ActionButton {
                    text: "Skip Stage";
                    enabled: root.can-skip-stage;
                    clicked => { root.skip-stage(); }
                }
            }
        }
    }
}
